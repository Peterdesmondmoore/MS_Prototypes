{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peterdesmondmoore.github.io/MS_Prototypes/schemas/prototype.schema.json",
  "title": "Mission Surface child prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productKey", "prototypeKey", "title", "description", "status", "formFactor", "deliveryMode", "fidelity", "limitations", "pages", "createdAt", "updatedAt", "repositoryKey"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productKey": { "$ref": "#/$defs/key" },
    "prototypeKey": { "$ref": "#/$defs/key" },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "enum": ["draft", "testing", "approved"] },
    "formFactor": { "enum": ["mobile", "laptop"] },
    "deliveryMode": { "enum": ["live", "screenshots"] },
    "fidelity": { "const": "simulated" },
    "limitations": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "pages": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "demoPath": { "type": "string", "minLength": 1, "maxLength": 255 },
    "entryRoute": { "type": "string", "minLength": 1, "maxLength": 500 },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version"],
      "properties": { "protocol": { "const": "mission-surface-prototype" }, "version": { "const": 1 } }
    },
    "screenshots": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/screenshot" } },
    "annotations": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/pageAnnotations" } },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "repositoryKey": { "$ref": "#/$defs/key" }
  },
  "allOf": [
    {
      "if": { "properties": { "deliveryMode": { "const": "live" } }, "required": ["deliveryMode"] },
      "then": { "required": ["demoPath", "entryRoute", "integration"], "properties": { "screenshots": { "maxItems": 0 } } },
      "else": { "required": ["screenshots"], "not": { "anyOf": [{ "required": ["demoPath"] }, { "required": ["entryRoute"] }, { "required": ["integration"] }] } }
    }
  ],
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "path", "altText"],
      "properties": {
        "page": { "type": "string", "minLength": 1, "maxLength": 120 },
        "path": { "type": "string", "pattern": "^/prototypes/[a-z0-9-]+/screenshots/[^/]+\\.(png|jpg|jpeg|webp)$", "maxLength": 500 },
        "altText": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "pageAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "items"],
      "properties": {
        "page": { "type": "string", "minLength": 1, "maxLength": 120 },
        "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/annotation" } }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "x", "y", "content"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 50 },
        "x": { "type": "number", "minimum": 0, "maximum": 100 },
        "y": { "type": "number", "minimum": 0, "maximum": 100 },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
